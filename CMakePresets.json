{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20 },
  "configurePresets": [
    {
      "name": "vs2022-x64-vcpkg",
      "displayName": "VS 2022 (x64) + vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64" },
      "binaryDir": "${sourceDir}/build-vs",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "vs2022-x64-vcpkg", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs2022-x64-vcpkg", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "ctest-debug",   "configurePreset": "vs2022-x64-vcpkg", "configuration": "Debug" },
    { "name": "ctest-release", "configurePreset": "vs2022-x64-vcpkg", "configuration": "Release" }
  ]
}
